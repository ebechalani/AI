# Copy to .env.local. Nothing here is needed for `npm run build`.
# As written, this file targets the Firebase emulators (`npm run emulators`).
# Commented-out variables are optional there; uncomment and fill them for a real project.

# --- Client (bundled into the browser; not secrets) -------------------------

# Firebase web config. Any non-empty values work against the emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-roboholic.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-roboholic
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-roboholic.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# "true" connects the Auth and Storage clients to the emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Canonical origin, used in certificate verification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Address behind the "For Schools" contact button. The button is hidden when unset.
# NEXT_PUBLIC_CONTACT_EMAIL=schools@example.com

# --- Server ------------------------------------------------------------------

# Admin SDK service account. The emulators need only the project id and the bucket.
FIREBASE_PROJECT_ID=demo-roboholic
FIREBASE_STORAGE_BUCKET=demo-roboholic.appspot.com
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the \n escapes when pasting the key.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Presence switches the Admin SDK to the emulators. They are rejected on Vercel and with a
# project id that does not start with "demo-". Remove all three for a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# HMAC key for hashing client IP addresses in rate-limit counters. Required outside the emulator.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# RATE_LIMIT_SECRET=

# "mock" (default, no network) or "anthropic".
AI_PROVIDER=mock
# Read only when AI_PROVIDER=anthropic. The model defaults to claude-opus-5-5.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional override of the platform-wide daily AI token budget (default 10000000).
# AI_DAILY_TOKEN_BUDGET=10000000

# --- Scripts -----------------------------------------------------------------

# Password of the demo accounts created by `npm run seed`. Optional on the emulator;
# required (16 or more characters) when seeding a real project.
# SEED_DEMO_PASSWORD=
