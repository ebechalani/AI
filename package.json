{
  "name": "roboholic-ai",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run check-messages",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:rules": "firebase emulators:exec --project demo-roboholic --only firestore,storage \"vitest run --project rules\"",
    "test:integration": "firebase emulators:exec --project demo-roboholic --only auth,firestore,storage \"vitest run --project integration\"",
    "emulators": "node -e \"require('node:fs').mkdirSync('.emulator-data', { recursive: true })\" && firebase emulators:start --project demo-roboholic --import .emulator-data --export-on-exit",
    "migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "seed": "tsx --conditions=react-server scripts/seed/index.ts",
    "admin:bootstrap": "tsx --conditions=react-server scripts/bootstrap-admin.ts",
    "user:delete": "tsx --conditions=react-server scripts/delete-user-data.ts",
    "cleanup:uploads": "tsx --conditions=react-server scripts/cleanup-uploads.ts",
    "smoke:queries": "tsx --conditions=react-server scripts/smoke-queries.ts",
    "check-messages": "tsx --conditions=react-server scripts/check-messages.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
